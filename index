function matches(e){const q=search.value.trim().toLocaleLowerCase('fr');return (!q||[e.n,e.s,e.name].some(v=>String(v).toLocaleLowerCase('fr').includes(q)))&&(state.value==='all'||e.state===state.value)&&(kind.value==='all'||e.family===kind.value)&&(blockFilter==='all'||blockOf(e)===blockFilter)}
function render(){ptable.innerHTML='';const corner=document.createElement('div');corner.className='axis-label group-label';corner.textContent='';corner.style.gridColumn='1';corner.style.gridRow='1';ptable.appendChild(corner);for(let g=1;g<=18;g++){const lab=document.createElement('div');lab.className='axis-label group-label';lab.textContent=g;lab.style.gridColumn=g+1;lab.style.gridRow='1';lab.title='Groupe '+g;ptable.appendChild(lab)}for(let per=1;per<=9;per++){const lab=document.createElement('div');lab.className='axis-label period-label';lab.textContent=per<=7?per:(per===8?'La':'Ac');lab.style.gridColumn='1';lab.style.gridRow=per+1;lab.title=per<=7?'Période '+per:(per===8?'Lanthanides':'Actinides');ptable.appendChild(lab)}for(const e of all){const isMatch=matches(e);const b=document.createElement('button');b.className='element'+(selected.n===e.n?' selected':'')+(isMatch?'':' dimmed');b.style.gridColumn=e.group+1;b.style.gridRow=e.period+1;b.style.setProperty('--c',colors[e.family]||'#9c8cff');b.title=`${e.name} · ${e.n} · Bloc ${blockOf(e).toUpperCase()}`;b.innerHTML=`<span class="num">${e.n}</span><span class="symbol">${e.s}</span><span class="ename">${e.name}</span><span class="mass">${e.mass}</span>`;b.addEventListener('click',()=>{selected=e;showDetail(e);render();document.getElementById('detail').scrollIntoView({behavior:'smooth',block:'start'});});ptable.appendChild(b)}}
function shellDistribution(z){const orbitals=[[1,2],[2,2],[2,6],[3,2],[3,6],[4,2],[3,10],[4,6],[5,2],[4,10],[5,6],[6,2],[4,14],[5,10],[6,6],[7,2],[5,14],[6,10],[7,6]];let left=z,counts={};for(const [n,cap] of orbitals){const take=Math.min(left,cap);counts[n]=(counts[n]||0)+take;left-=take;if(left<=0)break}return Object.entries(counts).sort((a,b)=>+a[0]-+b[0]).map(([n,v])=>({n,v}))}
function valenceCount(e){if(e.group===1)return 1;if(e.group===2)return 2;if(e.group>=13)return e.group-10;const shells=shellDistribution(e.n);return shells.length?shells[shells.length-1].v:1}
function lewisDots(symbol,count){const spots=[['42%','9%'],['91%','42%'],['58%','91%'],['9%','58%'],['58%','9%'],['91%','58%'],['42%','91%'],['9%','42%']];return `<div class="lewis-symbol">${symbol}${spots.slice(0,Math.max(0,Math.min(count,8))).map(([left,top])=>`<span class="lewis-dot" style="left:${left};top:${top}">•</span>`).join('')}</div>`}
function showDetail(e){const c=colors[e.family]||'#9c8cff';const shells=shellDistribution(e.n);const distribution=shells.map(x=>x.v).join(' · ');const valence=valenceCount(e);detail.innerHTML=`<div class="detail-main" style="--c:${c}"><div class="big-symbol"><span>${e.n}</span><strong>${e.s}</strong><span>${e.mass}</span></div><div><h2>${e.name}</h2><p>Symbole chimique : <b>${e.s}</b></p><span class="tag" style="--c:${c}">${e.family}</span></div></div><div class="detail-info"><div class="facts"><div class="fact"><small>Numéro atomique</small><strong>${e.n}</strong></div><div class="fact"><small>Masse atomique</small><strong>${e.mass} u</strong></div><div class="fact"><small>État (à température ambiante)</small><strong>${e.state}</strong></div><div class="fact"><small>Période</small><strong>${e.period>7?(e.period===8?'Lanthanides':'Actinides'):e.period}</strong></div><div class="fact"><small>Groupe</small><strong>${e.period>7?'—':e.group}</strong></div><div class="fact"><small>Famille</small><strong>${e.family}</strong></div></div></div><div class="electron-panels"><section class="electron-panel"><h3>Distribution des Électrons (K, L, M…)</h3><div class="shell-row">${shells.map((x,i)=>`<div class="shell" style="--shell-color:${['#f06c8d','#e7b05b','#7c9cff','#53d6bc','#bd91ff','#e49bd5','#64d8ce'][i%7]}"><small>${'KLMNOPQ'[x.n-1]||x.n}</small><b>${x.v}</b></div>`).join('')}</div><div class="shell-summary">Répartition : ${distribution}</div></section><section class="electron-panel"><h3>Représentation de Lewis</h3><div class="lewis-wrap">${lewisDots(e.s,valence)}</div><div class="lewis-note">Points représentant les électrons de valence du niveau externe. Pour les métaux de transition, cette représentation est indicative.</div></section></div>`}
[search,state,kind].forEach(el=>el.addEventListener('input',render));
document.querySelectorAll('.block-chip').forEach(btn=>btn.addEventListener('click',()=>{blockFilter=btn.dataset.block;document.querySelectorAll('.block-chip').forEach(x=>x.classList.toggle('active',x===btn));render()}));
document.getElementById('reset').onclick=()=>{search.value='';state.value='all';kind.value='all';blockFilter='all';document.querySelectorAll('.block-chip').forEach(x=>x.classList.toggle('active',x.dataset.block==='all'));selected=all[0];render();showDetail(selected)};
document.querySelector('[data-block="all"]').classList.add('active');
render();showDetail(selected);
</script>
<script>
(()=>{
 const box=document.getElementById('miniGames'); if(!box||typeof all==='undefined')return;
 let mode='guess', target=null, score=0, answered=false, remaining=30, ticker=null, speedStarted=false;
 const q=document.getElementById('gameQuestion'), answers=document.getElementById('gameAnswers'), status=document.getElementById('gameStatus'), scoreEl=document.getElementById('gameScore'), levelEl=document.getElementById('gameLevel'), clock=document.getElementById('gameClock');
 function level(){return score>=15?{name:'Difficile 🔥',count:6}:score>=8?{name:'Moyen ⚡',count:5}:{name:'Facile 🙂',count:4}}
 function updateHUD(){scoreEl.textContent='Score : '+score;levelEl.textContent='Level : '+level().name}
 const pick=a=>a[Math.floor(Math.random()*a.length)];
 function stopClock(){if(ticker){clearInterval(ticker);ticker=null}}
 function startClock(){stopClock();remaining=30;clock.textContent='⏱️ '+remaining+' s';ticker=setInterval(()=>{remaining--;clock.textContent='⏱️ '+remaining+' s';if(remaining<=0){stopClock();status.textContent='انتهى الوقت! نتيجتك: '+score;Array.from(answers.querySelectorAll('button')).forEach(b=>b.disabled=true)}},1000)}
 function newQuestion(){answered=false;status.textContent='';answers.innerHTML='';if(mode==='speed'&&!speedStarted){speedStarted=true;startClock()}if(mode!=='speed'){stopClock();clock.textContent=''}target=pick(all);
 let prompt, correct;
 const lv=level();
 if(score>=15){mode==='guess'?(prompt='Bloc '+blockOf(target).toUpperCase()+' : quel est le symbole de « '+target.name+' » ?',correct=target.s):(prompt='Quel est le numéro atomique de '+target.name+' ('+target.s+') ?',correct=String(target.n));}
 else
 if(mode==='guess'){prompt='Quel est le symbole de « '+target.name+' » ?';correct=target.s}
 else if(mode==='symbol'){prompt='Quel élément porte le symbole « '+target.s+' » ?';correct=target.name}
 else {prompt='Numéro atomique '+target.n+' : quel est cet élément ?';correct=target.name}
 q.textContent=prompt;const pool=[correct];while(pool.length<lv.count){const e=pick(all);const v=(score>=15?(mode==='guess'?e.s:String(e.n)):(mode==='guess'?e.s:e.name));if(!pool.includes(v))pool.push(v)}pool.sort(()=>Math.random()-.5);
 pool.forEach(v=>{const b=document.createElement('button');b.textContent=v;b.addEventListener('click',()=>choose(b,v,correct));answers.appendChild(b)});updateHUD()}
 function choose(btn,v,correct){if(answered)return;answered=true;const buttons=Array.from(answers.querySelectorAll('button'));buttons.forEach(b=>{b.disabled=true;if(b.textContent===correct)b.classList.add('correct')});if(v===correct){score++;updateHUD();status.textContent=score===8?'Bravo ! Niveau moyen débloqué ⚡':score===15?'🔥 Niveau difficile débloqué !':'Bravo ! Bonne réponse 🎉'}else{btn.classList.add('wrong');status.textContent='Pas tout à fait ! La bonne réponse : '+correct}if(mode==='speed'&&remaining<=0)stopClock()}
 function reset(){score=0;speedStarted=false;remaining=30;stopClock();clock.textContent='';updateHUD();newQuestion()}
 box.querySelectorAll('[data-game]').forEach(b=>b.addEventListener('click',()=>{mode=b.dataset.game;box.querySelectorAll('[data-game]').forEach(x=>x.classList.toggle('active',x===b));reset()}));
 document.getElementById('nextQuestion').addEventListener('click',()=>{if(mode==='speed'&&remaining<=0){status.textContent='اضغط «Recommencer» للعب من جديد.';return}newQuestion()});document.getElementById('restartGame').addEventListener('click',reset);newQuestion();
})();
</script>
</body></html>
